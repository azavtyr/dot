#!/usr/bin/env bash

set -e

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
platform=$(uname -s)

github_repo_path() {
	local origin_url repo_path

	if ! origin_url=$(git -C "$repo_dir" remote get-url origin 2>/dev/null); then
		printf '%s\n' 'Unable to determine the GitHub repository from the origin remote.' >&2
		return 1
	fi

	case $origin_url in
	https://github.com/* | http://github.com/* | git://github.com/*)
		repo_path=${origin_url#*://github.com/}
		;;
	git@github.com:*)
		repo_path=${origin_url#git@github.com:}
		;;
	ssh://git@github.com/*)
		repo_path=${origin_url#ssh://git@github.com/}
		;;
	*)
		printf 'Unsupported origin URL: %s\n' "$origin_url" >&2
		return 1
		;;
	esac

	repo_path=${repo_path%/}
	repo_path=${repo_path%.git}
	if [[ ! $repo_path =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ ]]; then
		printf 'Unable to derive a repository path from origin: %s\n' "$origin_url" >&2
		return 1
	fi

	printf '%s\n' "$repo_path"
}

relocate_repo() {
	local relative_dir repo_path repos_dir target_dir

	repos_dir=${REPOS:-"$HOME/Repos"}
	if [[ $repos_dir != /* ]]; then
		printf 'REPOS must be an absolute path: %s\n' "$repos_dir" >&2
		return 2
	fi
	mkdir -p "$repos_dir"
	repos_dir=$(CDPATH='' cd -- "$repos_dir" && pwd)

	case $repo_dir in
	"$repos_dir"/github.com/*)
		relative_dir=${repo_dir#"$repos_dir/github.com/"}
		if [[ $relative_dir == */* && ${relative_dir#*/} != */* ]]; then
			return
		fi
		;;
	esac

	repo_path=$(github_repo_path) || return
	target_dir="$repos_dir/github.com/$repo_path"

	if [[ $repo_dir == "$target_dir" ]]; then
		return
	fi

	if [[ -e $target_dir || -L $target_dir ]]; then
		if [[ $repo_dir -ef $target_dir ]]; then
			repo_dir=$(CDPATH='' cd -- "$target_dir" && pwd)
			return
		fi
		printf 'Cannot move dotfiles: destination already exists: %s\n' "$target_dir" >&2
		return 1
	fi

	mkdir -p "${target_dir%/*}"
	printf 'Moving dotfiles to %s\n' "$target_dir"
	mv "$repo_dir" "$target_dir"
	repo_dir=$target_dir
}

case $platform in
Darwin)
	"$repo_dir/install/mac/setup" "$@"
	;;
Linux)
	if (($# > 0)); then
		printf '%s\n' 'Setup options are only supported on macOS.' >&2
		exit 2
	fi
	if [[ ! -r /etc/os-release ]]; then
		printf '%s\n' 'Unable to identify the Linux distribution.' >&2
		exit 1
	fi
	# shellcheck source=/dev/null
	. /etc/os-release
	if [[ ${ID:-} != ubuntu ]]; then
		printf 'Unsupported Linux distribution: %s\n' "${ID:-unknown}" >&2
		exit 1
	fi
	"$repo_dir/install/ubuntu/setup"
	;;
*)
	printf 'Unsupported operating system: %s\n' "$platform" >&2
	exit 1
	;;
esac

relocate_repo

ln -sf "$repo_dir/bashrc" "$HOME/.bashrc"
ln -sf "$repo_dir/dircolors" "$HOME/.dircolors"
ln -sf "$repo_dir/profile" "$HOME/.profile"
ln -sf "$repo_dir/profile" "$HOME/.bash_profile"

for component in vim tmux lynx scripts wezterm; do
	"$repo_dir/$component/setup"
done

if [[ $platform == Darwin && ${1:-} == --opt ]]; then
	"$repo_dir/skhd/setup"
fi
