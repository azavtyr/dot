#!/usr/bin/env bash

set -e

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

case $(uname -s) in
Darwin)
	"$repo_dir/install/mac/setup"
	;;
Linux)
	if [[ ! -r /etc/os-release ]]; then
		printf '%s\n' 'Unable to identify the Linux distribution.' >&2
		exit 1
	fi
	# shellcheck source=/dev/null
	. /etc/os-release
	if [[ ${ID:-} != ubuntu ]]; then
		printf 'Unsupported Linux distribution: %s\n' "${ID:-unknown}" >&2
		exit 1
	fi
	"$repo_dir/install/ubuntu/setup"
	;;
*)
	printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
	exit 1
	;;
esac

ln -sf "$repo_dir/bashrc" "$HOME/.bashrc"
ln -sf "$repo_dir/dircolors" "$HOME/.dircolors"
ln -sf "$repo_dir/profile" "$HOME/.profile"
ln -sf "$repo_dir/profile" "$HOME/.bash_profile"

for component in vim tmux lynx scripts; do
	"$repo_dir/$component/setup"
done
